# ==========================================================================
# 我的小窝 · Git 忽略规则
# --------------------------------------------------------------------------
# 原则:源码、模板、样式、配置模板、文档 → 入库
#       运行时产物、密钥、数据库、上传文件、本地环境、运维脚本 → 不入库
#
# 注意:本文件不支持行尾注释,# 只有出现在行首才是注释
# 检查某条规则命中哪个文件:git check-ignore -v <路径>
# 被忽略但确实要提交:git add -f <路径>
# ==========================================================================


# --------------------------------------------------------------------------
# 一、操作系统与文件管理器
# --------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# --------------------------------------------------------------------------
# 二、编辑器与 IDE
# --------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*.swn
*~
~$*
.project
.classpath
.settings/
.history/
*.code-workspace


# --------------------------------------------------------------------------
# 三、Python 运行环境与字节码
# --------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class
*.so

# 虚拟环境(本地开发用,依赖见 admin/requirements.txt)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
.python-version

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml


# --------------------------------------------------------------------------
# 四、数据库与后台运行时数据(内容数据,绝不能进仓库)
# --------------------------------------------------------------------------
admin/data/
admin/backups/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.gz


# --------------------------------------------------------------------------
# 五、密钥与本地配置(泄露即失守)
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets.json
credentials.json


# --------------------------------------------------------------------------
# 六、后台上传的图片(访客上传的运行时数据)
# --------------------------------------------------------------------------
# 目录本身由 Flask 启动时自动创建,内容不入库
assets/uploads/


# --------------------------------------------------------------------------
# 七、运维脚本(含服务器 IP / 路径等环境信息,只留本地)
# --------------------------------------------------------------------------
# deploy/ 下的 .sh 脚本含服务器地址与部署细节,不随仓库公开;
# 部署流程与配置以 deploy/*.py、deploy/*.conf 为准。
*.sh


# --------------------------------------------------------------------------
# 八、日志与临时文件
# --------------------------------------------------------------------------
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.cache
.cache/
tmp/
temp/
*.bak
*.orig
*.rej
*.patch.tmp


# --------------------------------------------------------------------------
# 九、前端构建产物与依赖
# --------------------------------------------------------------------------
node_modules/
dist/
build/
.output/
.next/
.nuxt/
.svelte-kit/
.parcel-cache/
.eslintcache
stylelintcache

# v5.0 后端虚拟环境与缓存
backend/.venv/
backend/**/__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
cprof-*/


# --------------------------------------------------------------------------
# 十、打包与压缩产物(部署包、备份包)
# --------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz


# --------------------------------------------------------------------------
# 十一、本地杂项与临时工作文件
# --------------------------------------------------------------------------
information/
deploy/_stage_*/
deploy/_smoke_*.py
deploy/_probe*
deploy/_server_*.conf
*.local

# AI 工具本地会话计划(不入库)
.zcode/
